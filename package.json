{
  "name": "lunaharness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "luna": "bin/luna.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:app": "tauri build --no-bundle",
    "test": "vitest run",
    "tauri": "tauri",
    "test:rust": "scripts\\with-msvc.cmd cargo test --manifest-path src-tauri\\Cargo.toml",
    "test:smoke": "scripts\\with-msvc.cmd cargo test --manifest-path src-tauri\\Cargo.toml --test cli_smoke -- --ignored --nocapture"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
